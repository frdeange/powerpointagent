// For format details, see https://aka.ms/devcontainer.json
// Project: PowerPoint Agent — Multi-Agent PPTX Generator
// Build strategy: images built via `az acr build` (ACR Tasks) — no local Docker needed.
{
	"name": "PowerPoint Agent — Python 3.13",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// ── DevContainer Features ──────────────────────────────────────────────────
	// Docker-in-Docker is used to build and push container images to ACR locally.
	"features": {
		"ghcr.io/devcontainers/features/azure-cli:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/rchaganti/vsc-devcontainer-features/azurebicep:1": {},
		"ghcr.io/azure/azure-dev/azd:0": {},
		"ghcr.io/devcontainers-extra/features/node-asdf:0": {}
	},
	// ── Port forwarding for local development ─────────────────────────────────
	"forwardPorts": [
		3978,
		8000,
		8001,
		8002
	],
	"portsAttributes": {
		"3978": {
			"label": "Bot Service (aiohttp)",
			"onAutoForward": "notify"
		},
		"8000": {
			"label": "Orchestrator",
			"onAutoForward": "notify"
		},
		"8001": {
			"label": "PPTX MCP Server",
			"onAutoForward": "notify"
		},
		"8002": {
			"label": "Image MCP Server",
			"onAutoForward": "notify"
		}
	},
	// ── Post-create setup ──────────────────────────────────────────────────────
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	// ── VS Code customizations ─────────────────────────────────────────────────
	"customizations": {
		"vscode": {
			"extensions": [
				// Python
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				"ms-python.black-formatter",
				// Azure
				"ms-azuretools.vscode-bicep",
				"ms-azuretools.vscode-azurecontainerapps",
				"ms-vscode.azurecli",
				// GitHub
				"GitHub.vscode-pull-request-github",
				"GitHub.copilot",
				// Other
				"redhat.vscode-yaml",
				"ms-vscode.makefile-tools"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.analysis.typeCheckingMode": "basic",
				"editor.formatOnSave": true,
				"[python]": {
					"editor.defaultFormatter": "ms-python.black-formatter"
				},
				"editor.rulers": [
					100
				]
			}
		}
	}
}
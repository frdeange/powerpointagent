# ============================================================
# Azure AI Foundry
# ============================================================
AZURE_AI_PROJECT_ENDPOINT=https://<your-project>.api.azureml.ms
AZURE_AI_PROJECT_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_AI_PROJECT_RESOURCE_GROUP=<your-resource-group>
AZURE_AI_PROJECT_NAME=<your-ai-project-name>

# Azure OpenAI deployment name (e.g. gpt-4o, gpt-4.1, gpt-5)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Bing Grounding project connection id (from Foundry portal)
BING_PROJECT_CONNECTION_ID=<your-bing-connection-id>

# ============================================================
# Azure Storage
# ============================================================
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>

# Blob container names
BLOB_CONTAINER_TEMPLATES=templates
BLOB_CONTAINER_GENERATED=generated
BLOB_CONTAINER_IMAGES=images
BLOB_CONTAINER_UPLOADS=uploads

# ============================================================
# MCP Servers (Azure Container Apps external ingress URLs)
# ============================================================
PPTX_MCP_SERVER_URL=https://pptx-mcp.<aca-env>.eastus2.azurecontainerapps.io/mcp
IMAGE_MCP_SERVER_URL=https://image-mcp.<aca-env>.eastus2.azurecontainerapps.io/mcp

# ============================================================
# Bot Service (M365 Agents SDK)
# ============================================================
MICROSOFT_APP_ID=<your-bot-app-id>
MICROSOFT_APP_PASSWORD=<your-bot-app-password>
MICROSOFT_APP_TENANT_ID=<your-tenant-id>

# Orchestrator internal ACA URL
ORCHESTRATOR_URL=https://orchestrator.<aca-env>.internal.azurecontainerapps.io

# ============================================================
# Azure Container Registry
# ============================================================
ACR_NAME=<your-acr-name>
ACR_LOGIN_SERVER=<your-acr-name>.azurecr.io

# ============================================================
# Azure Container Apps
# ============================================================
ACA_ENVIRONMENT_NAME=<your-aca-environment>
ACA_RESOURCE_GROUP=<your-resource-group>
ACA_LOCATION=eastus2

# ============================================================
# Image Generation (Azure OpenAI DALL-E)
# ============================================================
AZURE_OPENAI_DALLE_ENDPOINT=https://<your-openai>.openai.azure.com
AZURE_OPENAI_DALLE_API_KEY=<your-dalle-api-key>
AZURE_OPENAI_DALLE_DEPLOYMENT=dall-e-3

# ============================================================
# Bing Search (for stock images)
# ============================================================
BING_SEARCH_API_KEY=<your-bing-search-key>
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com
